---
import { slugify } from "../js/utils";

export interface Tab {
  label: string;
  content: string;
}

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;

// Why the `<li role="none">`: https://inclusive-components.design/tabbed-interfaces/
// Why the `tabindex="0"` on the tabpanels: https://www.w3.org/WAI/ARIA/apg/patterns/tabs/examples/tabs-manual/#:~:text=it%20is%20recommended%20that%20all%20tabpanel%20elements%20in%20a%20tab%20set%20are%20focusable
---

<app-tabs>
  <ul role="tablist">
    {
      tabs.map(({ label }, index) => (
        <li role="none">
          <button
            type="button"
            id={`tab-${slugify(label)}`}
            class="button secondary"
            role="tab"
            aria-controls={`tabpanel-${slugify(label)}`}
            aria-selected={index === 0}
            tabindex={index === 0 ? "0" : "-1"}
          >
            {label}
          </button>
        </li>
      ))
    }
  </ul>
  {
    tabs.map(({ label, content }, index) => (
      <section
        id={`tabpanel-${slugify(label)}`}
        role="tabpanel"
        aria-labelledby={`tab-${slugify(label)}`}
        hidden={index !== 0}
        tabindex="0"
      >
        {content}
      </section>
    ))
  }
</app-tabs>

<style lang="scss">
  [role="tablist"] {
    display: flex;

    button:focus-visible {
      position: relative; /* Ensure the focused tab shows above the others */
    }

    li + li {
      margin-left: -1px; /* Compensate for border */
    }

    button[aria-selected="true"] {
      text-decoration-line: underline;

      &:not(:focus-visible) {
        border-bottom-color: transparent;
      }
    }
  }

  [role="tabpanel"] {
    border: 1px solid;
    padding: 16px;
    margin-top: -1px; /* Compensate for border */
  }
</style>

<script>
  class AppTabs extends HTMLElement {
    connectedCallback() {
      const tabs = this.querySelectorAll('[role="tab"]') as NodeListOf<HTMLButtonElement>;
      const tabpanels = this.querySelectorAll('[role="tabpanel"]') as NodeListOf<HTMLElement>;
      let focusIndex = 0;

      tabs.forEach((tab) => {
        tab.addEventListener("click", (e) => {
          const clickedTab = e.currentTarget as HTMLButtonElement;
          const tabpanelId = clickedTab.getAttribute("aria-controls");
          focusIndex = Array.from(tabs).indexOf(clickedTab);

          tabs.forEach((tab) => {
            const isActive = tab === clickedTab;
            tab.setAttribute("aria-selected", String(isActive));
            tab.setAttribute("tabindex", isActive ? "0" : "-1");
          });

          tabpanels.forEach((tabpanel) => {
            const isActive = tabpanel.id === tabpanelId;
            tabpanel.hidden = !isActive;
          });
        });

        // Roving tabindex implementation for keyboard navigation
        tab.addEventListener("keydown", (e) => {
          const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
          if (!keys.includes(e.key)) return;
          e.preventDefault();

          const minIndex = 0;
          const maxIndex = tabs.length - 1;
          // Go to the first or last tab
          if (e.key === "Home") focusIndex = minIndex;
          if (e.key === "End") focusIndex = maxIndex;
          // Move to the next or previous tab
          if (e.key === "ArrowRight") focusIndex++;
          if (e.key === "ArrowLeft") focusIndex--;
          // Loop around the tabs
          if (focusIndex < minIndex) focusIndex = maxIndex;
          if (focusIndex > maxIndex) focusIndex = minIndex;

          tabs[focusIndex].focus();
        });
      });
    }
  }

  customElements.define("app-tabs", AppTabs);
</script>
